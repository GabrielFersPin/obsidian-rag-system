# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Paths
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
CHROMA_PERSIST_DIR=./chroma_db
MODELS_CACHE_DIR=./models

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
